{
  "routes": [
    {
      "src": "/(.*\\.(js|mjs|css|png|jpg|jpeg|gif|svg|ico|webp|avif|woff|woff2|ttf|otf|mp3|wav|ogg|json|webmanifest|wasm))",
      "dest": "$1"
    },
    {
      "src": "/(privacy|tos)(\\.html)?",
      "dest": "$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}
